# Configure no ambiente do processo Node. Não há leitura automática de .env.
PORT=4173
# Padrão: pasta data/ na raiz. Em hospedagem, use volume persistente privado.
# FOURBIKE_DATA_DIR=/var/lib/fourbike
# Ative somente atrás de um proxy HTTPS confiável.
FOURBIKE_TRUST_PROXY=0
# Opcional: fixa a origem autorizada para administração.
# FOURBIKE_PUBLIC_ORIGIN=https://fourbike.com.br
